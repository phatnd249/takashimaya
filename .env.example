# Production domain or base URL (e.g. https://username.github.io/Takashimaya/ or custom domain)
VITE_SITE_URL=https://username.github.io/Takashimaya/

# WordPress REST API endpoint
VITE_WP_API_URL=https://share4happy.com/wp-json/wp/v2/posts
VITE_WP_CATEGORY_ID=208
VITE_WP_POSTS_PER_PAGE=5

# Optional fallback category if 208 has 0 posts (e.g. 207 or empty string for all latest posts)
VITE_WP_FALLBACK_CATEGORY=207
